<?xml version="1.0" ?>
<mxfile host="app.diagrams.net" modified="2026-09-19T00:00:00.000Z" agent="Claude" version="24.7.5" type="device">
  <diagram id="overview" name="1. site.yml overview">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1450" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="overview-title" value="compliance-orchestrator: ansible/playbooks/site.yml" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="0" width="820" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="overview-n1" value="Start:
ansible-playbook site.yml [--tags ...]" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="50" width="320" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="overview-note_tags" value="Tag shortcuts (site.yml header):
--tags attack     -&gt; caldera + atomic
--tags cis        -&gt; prowler + openscap
--tags zerotrust  -&gt; pingcastle
--tags ai         -&gt; garak
(combine freely, e.g. --tags prowler,openscap)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="260" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="overview-p1" value="import_playbook: run_caldera.yml
Play: hosts=caldera_control (localhost)
gather_facts=true
role: caldera_operation
tags: [caldera, attack]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="320" y="150" width="320" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="overview-s1" value="ATT&amp;CK emulation via Caldera REST API
→ see page 'caldera_operation'" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=4;" vertex="1" parent="1">
          <mxGeometry x="780" y="165" width="280" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="overview-p2" value="import_playbook: run_atomic.yml
Play A: hosts=atomic_targets_windows (winrm)
         atomic_runner=powershell
Play B: hosts=atomic_targets_linux (ssh)
         atomic_runner=atomic_operator
role: atomic_redteam | tags: [atomic, attack]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="320" y="290" width="320" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="overview-s2" value="Atomic Red Team technique execution
→ see page 'atomic_redteam'" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=4;" vertex="1" parent="1">
          <mxGeometry x="780" y="320" width="280" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="overview-p3" value="import_playbook: run_prowler.yml
Play: hosts=cloud_scan_control
gather_facts=false
role: prowler_scan
tags: [prowler, cis, nist, cloud]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="320" y="450" width="320" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="overview-s3" value="Cloud CIS/NIST-800-53 scan via Prowler CLI
→ see page 'prowler_scan'" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=4;" vertex="1" parent="1">
          <mxGeometry x="780" y="465" width="280" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="overview-p4" value="import_playbook: run_openscap.yml
Play: hosts=linux_scan_targets
gather_facts=true
role: openscap_scan
tags: [openscap, cis]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="320" y="590" width="320" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="overview-s4" value="Host-level CIS scan via oscap
(SSH + become, runs ON target)
→ see page 'openscap_scan'" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=4;" vertex="1" parent="1">
          <mxGeometry x="780" y="605" width="280" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="overview-p5" value="import_playbook: run_pingcastle.yml
Play: hosts=ad_scan_host (winrm)
gather_facts=false
role: pingcastle_scan
tags: [pingcastle, zerotrust, identity]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="320" y="730" width="320" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="overview-s5" value="AD health check (Zero Trust identity pillar)
→ see page 'pingcastle_scan'" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=4;" vertex="1" parent="1">
          <mxGeometry x="780" y="745" width="280" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="overview-p6" value="import_playbook: run_garak.yml
Play: hosts=ai_redteam_control
gather_facts=false
role: garak_scan
tags: [ai, owasp, garak]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="320" y="870" width="320" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="overview-s6" value="LLM red-team scan (OWASP LLM Top 10)
→ see page 'garak_scan'" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=4;" vertex="1" parent="1">
          <mxGeometry x="780" y="885" width="280" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="overview-n_results" value="All 6 roles write raw tool output under
results/&lt;tool&gt;/... on the control node" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="320" y="1015" width="320" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="overview-n_agg1" value="Manual/CI step (outside Ansible):
python main.py aggregate
--results-dir results --out report" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="1115" width="320" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="overview-n_agg2" value="python main.py aggregate-ai
--results-dir results --out report/ai
(garak / OWASP LLM Top 10 – kept as a separate report)" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="1230" width="320" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="overview-n_end" value="Unified compliance report:
CIS, NIST 800-53, ATT&amp;CK, Zero Trust (identity), OWASP LLM" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
