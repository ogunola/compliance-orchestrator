  <diagram id="caldera_operation" name="2. caldera_operation">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1450" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="caldera_operation-title" value="role: caldera_operation  (hosts=caldera_control, gather_facts=true, tags=[caldera, attack])" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="0" width="900" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="caldera_operation-n1" value="Start role: caldera_operation" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="50" width="320" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="caldera_operation-n2" value="Ensure local results dir exists
results/caldera/  (file: state=directory)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="320" y="140" width="320" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="caldera_operation-n3" value="POST {{caldera_url}}/api/v2/operations
body: adversary_id, group, planner=atomic, state=running
register: caldera_op" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="320" y="235" width="320" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="caldera_operation-n4" value="set_fact: caldera_operation_id
= caldera_op.json.id" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="320" y="350" width="320" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="caldera_operation-n5" value="GET .../operations/{{caldera_operation_id}}
register: caldera_status" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="320" y="440" width="320" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="caldera_operation-n6" value="caldera_status.json.state
== 'finished' ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="535" width="280" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="caldera_operation-n7" value="POST .../operations/{{id}}/report
register: caldera_report" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="320" y="660" width="320" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="caldera_operation-n8" value="Save raw report JSON
results/caldera/operation-{{id}}.json
(copy: content=to_nice_json)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="320" y="755" width="320" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="caldera_operation-n9" value="End: debug summary
(operation id + report path)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="860" width="320" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="caldera_operation-note1" value="until/retries loop:
retries = caldera_poll_timeout_sec /
caldera_poll_interval_sec
delay = caldera_poll_interval_sec
(defaults: 1800s timeout / 10s interval
= up to 180 polls)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="780" y="520" width="280" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="caldera_operation-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="caldera_operation-n1" target="caldera_operation-n2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="caldera_operation-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="caldera_operation-n2" target="caldera_operation-n3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="caldera_operation-e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="caldera_operation-n3" target="caldera_operation-n4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="caldera_operation-e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="caldera_operation-n4" target="caldera_operation-n5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="caldera_operation-e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="caldera_operation-n5" target="caldera_operation-n6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="caldera_operation-e6" value="no – wait &amp;
retry" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;strokeColor=#6c8ebf;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="caldera_operation-n6" target="caldera_operation-n5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="caldera_operation-e7" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="caldera_operation-n6" target="caldera_operation-n7">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="caldera_operation-e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="caldera_operation-n7" target="caldera_operation-n8">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="caldera_operation-e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="caldera_operation-n8" target="caldera_operation-n9">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="caldera_operation-en1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=none;strokeColor=#999999;" edge="1" parent="1" source="caldera_operation-note1" target="caldera_operation-n6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="atomic_redteam" name="3. atomic_redteam">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1450" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="atomic_redteam-title" value="role: atomic_redteam  (invoked from both the Windows play and the Linux/macOS play, tags=[atomic, attack])" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="0" width="940" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="atomic_redteam-n1" value="Start role: atomic_redteam
(runs once per targeted host)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="50" width="320" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="atomic_redteam-n2" value="ansible_connection == 'winrm'
and atomic_runner == 'powershell' ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="145" width="300" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="atomic_redteam-w1" value="(Windows) ensure
C:\ansible_results\atomic exists
(win_file)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="280" width="320" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="atomic_redteam-w2" value="(Windows) loop over atomic_techniques:
Invoke-AtomicTest &lt;id&gt; -Confirm:$false
via win_shell  |  ignore_errors: true" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="375" width="320" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="atomic_redteam-w3" value="loop: fetch C:\...\&lt;id&gt;.log
to results/atomic/&lt;host&gt;/&lt;id&gt;.log
ignore_errors: true" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="480" width="320" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="atomic_redteam-n3" value="ansible_connection == 'ssh'
and atomic_runner == 'atomic_operator' ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="280" width="300" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="atomic_redteam-l1" value="(Linux/macOS) ensure
/tmp/ansible_results/atomic exists" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="580" y="400" width="320" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="atomic_redteam-l2" value="(Linux/macOS) loop over atomic_techniques:
atomic-operator run --techniques &lt;id&gt;
--check-prereqs  |  ignore_errors: true" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="490" width="320" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="atomic_redteam-l3" value="loop: fetch /tmp/.../&lt;id&gt;.log
to results/atomic/&lt;host&gt;/&lt;id&gt;.log
