          <mxGeometry x="10" y="0" width="960" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="openscap_scan-n1" value="Start role: openscap_scan
(runs once per host in linux_scan_targets)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="50" width="320" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="openscap_scan-n2" value="package: install oscap_packages
(openscap-scanner, scap-security-guide)
become: true" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="320" y="145" width="320" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="openscap_scan-n3" value="file: ensure /tmp/ansible_results/openscap
exists on target  |  become: true" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="320" y="255" width="320" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="openscap_scan-n4" value="command: oscap xccdf eval
--profile {{oscap_profile}}
--results results-&lt;host&gt;.xml
--report report-&lt;host&gt;.html
{{oscap_datastream}}  |  become: true
register: oscap_run" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="320" y="355" width="320" height="120" as="geometry"/>
